{
  "info": {
    "_postman_id": "7a3e8b41-9921-4f1a-b605-meditrack2026",
    "name": "MediTrack Pharmacy & Healthcare API",
    "description": "Production-grade REST API collection for MediTrack Core Services, including Health Telemetry, Clinical Drug-Drug Interaction (DDI) Evaluation, Schedule H Regulatory Compliance, and GSTIN Invoice Auditing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://meditrackos.vercel.app",
      "type": "string",
      "description": "Production base URL or local development server (e.g. http://localhost:5173)"
    }
  ],
  "item": [
    {
      "name": "System & Telemetry",
      "item": [
        {
          "name": "1. Gateway Health & Microservices Telemetry",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Inspects real-time serverless API runtime, active engine version, latency telemetry, and microservices status."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Clinical Safety & DDI Engine",
      "item": [
        {
          "name": "2. Evaluate Drug Interactions - Critical Hazard (Nitrate + PDE5)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"medicines\": [\n    {\n      \"name\": \"Sorbitrate 10mg\",\n      \"generic\": \"Isosorbide Dinitrate\"\n    },\n    {\n      \"name\": \"Manforce 50mg\",\n      \"generic\": \"Sildenafil Citrate\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/clinical/interactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clinical", "interactions"]
            },
            "description": "Evaluates synergistic vasodilation contraindication between Nitrates and PDE-5 inhibitors. Returns CRITICAL safety risk tier with bilingual Tamil and English clinical alerts."
          },
          "response": []
        },
        {
