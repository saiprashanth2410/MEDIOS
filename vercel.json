{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/clinical/interactions",
      "destination": "/api/interactions"
    },
    {
      "source": "/api/clinical/compliance",
      "destination": "/api/compliance"
    },
    {
      "source": "/api/billing/audit",
      "destination": "/api/audit"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/:match*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}